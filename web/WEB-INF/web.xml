<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    
    <listener>
        <listener-class>com.lostfound.listeners.AppContextListener</listener-class>
    </listener>
    
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.lostfound.controllers.LoginServlet</servlet-class>
        
        <!--admin-->
        <init-param>
            <param-name>adminUser</param-name>
            <param-value>admin</param-value>
        </init-param>
        <init-param>
            <param-name>adminPass</param-name>
            <param-value>admin123</param-value>
        </init-param>
        
        <!--student-->
        <init-param>
            <param-name>studentUser</param-name>
            <param-value>student</param-value>
        </init-param>
        <init-param>
            <param-name>studentPass</param-name>
            <param-value>student123</param-value>
        </init-param>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login/</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.lostfound.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/lagoutt<url-pattern>
    </servlet-mapping>
</web-app>
